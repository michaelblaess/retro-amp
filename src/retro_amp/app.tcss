Screen {
    layout: vertical;
}

/* 4fr/1fr-Aufteilung mit dem Log-Panel — der Log skaliert proportional
   mit. Der HorizontalSplitter setzt nach einem Drag konkrete Zellen. */
#main-container {
    height: 4fr;
    min-height: 10;
    layout: horizontal;
}

/* Initial-Groesse als Prozent (skaliert mit Terminalbreite). VerticalSplitter
   ueberschreibt das nach erstem Drag mit konkreten Zellen-Werten — auch das
   Restore aus den Settings setzt int Cells, was die Prozent-Regel ueberschreibt. */
#left-panel {
    width: 30%;
    min-width: 20;
    max-width: 80;
    height: 1fr;
}

#right-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

/* Initial-Hoehe als Prozent — HorizontalSplitter setzt dann konkrete Zellen.
   FileTable.DEFAULT_CSS hat height: 1fr — ID-Selektor uebersteuert. */
#file-table {
    height: 50%;
    min-height: 5;
}

/* Layout/Background/Focus der globalen Suche kommen aus textual-widgets
   (SearchInputWithHistory .search-row + :focus-within) — eigene Overrides
   wuerden mit dem Wrapper-Border kollidieren. */

#content-tabs {
    height: 1fr;
}

#transport-row {
    height: 5;
    layout: horizontal;
    border-top: solid $ra-divider;
    border-bottom: solid $ra-divider;
}

#left-tabs {
    height: 1fr;
}

#left-tabs ContentSwitcher {
    height: 1fr;
}

#left-tabs TabPane {
    height: 1fr;
}

/* Dateien-Tab: Sidebar oben (auto-Hoehe), FolderBrowser fuellt den Rest. */
#browser-pane {
    height: 1fr;
    layout: vertical;
}

#browser-pane > #folder-browser {
    height: 1fr;
}

/* Splitter oberhalb des Log-Panels — nur sichtbar wenn der Log sichtbar ist */
#log-splitter {
    display: none;
}

#log-splitter.visible {
    display: block;
}

#app-log {
    height: 1fr;
    min-height: 5;
    max-height: 30;
    border-top: solid $ra-divider;
    background: $surface;
    padding: 0 1;
    display: none;
}

#app-log.visible {
    display: block;
}

/* Collapse-Icon in der Log-Titelzeile: nur der Log-Body verschwindet,
   die Titelzeile (Splitter) bleibt als schmale Leiste sichtbar. */
#app-log.visible.collapsed {
    display: none;
}

/* ── Abgeleitete Flaechenfarben ($ra-*) ──────────────────────────────
   Die Widgets bringen in ihrem DEFAULT_CSS Textuals Grundfarben mit, damit
   sie auch ausserhalb dieser Anwendung laufen (die Tests bauen sie in eine
   nackte App). Hier werden sie ueberschrieben - das App-Stylesheet sticht
   das DEFAULT_CSS eines Widgets.

   Warum ueberhaupt: eine Trennlinie in voller Akzentfarbe ist der
   Bueroschreibtisch-Eindruck, von dem die Optik wegsoll. `$ra-divider` ist
   dieselbe Linie als ruhige Rille - sichtbar, aber leiser als die Schrift,
   und ein Test haelt genau das fest. */

ControlPanel {
    border-right: solid $ra-divider;
}

Visualizer {
    border-right: solid $ra-divider;
}

/* Die Titelzeile der Dateiliste war ein voller Akzentbalken. Als Flaeche in
   Panel-Ton traegt sie dieselbe Angabe, ohne den Blick zu ziehen. */
FileTable #file-info {
    background: $ra-header;
    color: $text;
}

QuickJumpItem:hover {
    background: $ra-selection;
}
