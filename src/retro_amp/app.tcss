Screen {
    layout: vertical;
}

#main-container {
    height: 1fr;
    layout: horizontal;
}

/* Konkrete Breite (nicht 1fr / %) damit der VerticalSplitter sie aendern kann.
   Initial wird sie in on_mount aus den Settings restauriert. */
#left-panel {
    width: 30;
    min-width: 20;
    height: 1fr;
}

#right-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

/* Konkrete Hoehe fuer die FileTable damit der HorizontalSplitter sie aendern kann.
   FileTable.DEFAULT_CSS hat height: 1fr — ID-Selektor uebersteuert. */
#file-table {
    height: 15;
    min-height: 5;
}

/* Layout/Background/Focus der globalen Suche kommen aus textual-widgets
   (SearchInputWithHistory .search-row + :focus-within) — eigene Overrides
   wuerden mit dem Wrapper-Border kollidieren. */

#content-tabs {
    height: 1fr;
}

#transport-row {
    height: 5;
    layout: horizontal;
    border-top: solid $accent;
    border-bottom: solid $accent;
}

#left-tabs {
    height: 1fr;
}

#left-tabs ContentSwitcher {
    height: 1fr;
}

#left-tabs TabPane {
    height: 1fr;
}

#app-log {
    height: 10;
    min-height: 5;
    max-height: 15;
    border-top: solid $accent;
    background: $surface;
    padding: 0 1;
    display: none;
}

#app-log.visible {
    display: block;
}
