Screen {
    layout: vertical;
}

#main-container {
    height: 1fr;
    layout: horizontal;
}

#left-panel {
    width: 30%;
    min-width: 20;
    height: 1fr;
    border-right: solid $accent;
}

#right-panel {
    width: 70%;
    height: 1fr;
    layout: vertical;
}

#tab-separator {
    color: $accent;
    margin: 0;
}

/* Layout/Background/Focus der globalen Suche kommen aus textual-widgets
   (SearchInputWithHistory .search-row + :focus-within) — eigene Overrides
   wuerden mit dem Wrapper-Border kollidieren. */

#content-tabs {
    height: 1fr;
}

#transport-row {
    height: 5;
    layout: horizontal;
    border-top: solid $accent;
    border-bottom: solid $accent;
}

#left-tabs {
    height: 1fr;
}

#left-tabs ContentSwitcher {
    height: 1fr;
}

#left-tabs TabPane {
    height: 1fr;
}

#app-log {
    height: 10;
    min-height: 5;
    max-height: 15;
    border-top: solid $accent;
    background: $surface;
    padding: 0 1;
    display: none;
}

#app-log.visible {
    display: block;
}
