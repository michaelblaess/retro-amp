Screen {
    layout: vertical;
}

/* 4fr/1fr-Aufteilung mit dem Log-Panel — der Log skaliert proportional
   mit. Der HorizontalSplitter setzt nach einem Drag konkrete Zellen. */
#main-container {
    height: 4fr;
    min-height: 10;
    layout: horizontal;
}

/* Initial-Groesse als Prozent (skaliert mit Terminalbreite). VerticalSplitter
   ueberschreibt das nach erstem Drag mit konkreten Zellen-Werten — auch das
   Restore aus den Settings setzt int Cells, was die Prozent-Regel ueberschreibt. */
#left-panel {
    width: 30%;
    min-width: 20;
    max-width: 80;
    height: 1fr;
}

#right-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

/* Initial-Hoehe als Prozent — HorizontalSplitter setzt dann konkrete Zellen.
   FileTable.DEFAULT_CSS hat height: 1fr — ID-Selektor uebersteuert. */
#file-table {
    height: 50%;
    min-height: 5;
}

/* Layout/Background/Focus der globalen Suche kommen aus textual-widgets
   (SearchInputWithHistory .search-row + :focus-within) — eigene Overrides
   wuerden mit dem Wrapper-Border kollidieren. */

#content-tabs {
    height: 1fr;
}

#transport-row {
    height: 5;
    layout: horizontal;
    border-top: solid $accent;
    border-bottom: solid $accent;
}

#left-tabs {
    height: 1fr;
}

#left-tabs ContentSwitcher {
    height: 1fr;
}

#left-tabs TabPane {
    height: 1fr;
}

/* Splitter oberhalb des Log-Panels — nur sichtbar wenn der Log sichtbar ist */
#log-splitter {
    display: none;
}

#log-splitter.visible {
    display: block;
}

#app-log {
    height: 1fr;
    min-height: 5;
    max-height: 30;
    border-top: solid $accent;
    background: $surface;
    padding: 0 1;
    display: none;
}

#app-log.visible {
    display: block;
}
